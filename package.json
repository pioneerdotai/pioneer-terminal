{
  "name": "pioneer-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "node --import tsx server.ts",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "build:server": "bun build server.ts --target=node --format=cjs --packages=external --define 'process.env.NODE_ENV=\"production\"' --outfile=build/server.cjs",
    "build:pioneer": "node scripts/pioneer/build.mjs",
    "package:pioneer": "node scripts/pioneer/package.mjs",
    "assemble:pioneer": "node scripts/pioneer/assemble.mjs",
    "preview:microsandbox": "node scripts/pioneer/preview.mjs",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "lint": "eslint --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test:e2e": "node run-e2e.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prestart": "node scripts/prepare-assets.mjs",
    "lint:fix": "eslint --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@wterm/core": "0.5.10",
    "@wterm/dom": "0.5.10",
    "@wterm/ghostty": "0.5.10",
    "@wterm/react": "0.5.10",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "node-pty": "^1.0.0",
    "postcss": "^8.5.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  }
}
